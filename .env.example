# Application Environment
ENVIRONMENT=development
DEBUG=True
PROJECT_NAME="CortexRAG"
SECRET_KEY="cortexrag-enterprise-secret-key-change-in-production-2026"

# Database Configuration
# Local SQLite default:
DATABASE_URL=sqlite+aiosqlite:///./cortexrag.db
# Production PostgreSQL + pgvector:
# DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/cortexrag

# Redis (Semantic Cache & Rate Limiter)
# REDIS_URL=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_TOKENS_PER_MINUTE=60
RATE_LIMIT_BURST_CAPACITY=10

# AI Models (Optional - High-fidelity local deterministic synthesizer used if empty)
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini
